%  ---- Orbit View ----
Create OrbitView WalkerView;
GMAT WalkerView.ShowPlot = true;
GMAT WalkerView.Add = {A1, A2, A3, A4, A5, A6, A7, A8, B1, B2, B3, B4, B5, B6, B7, B8, C1, C2, C3, C4, C5, C6, C7, C8, Earth};
GMAT WalkerView.CoordinateSystem = EarthMJ2000Eq;
GMAT WalkerView.ViewPointReference = Earth;
GMAT WalkerView.ViewPointVector = [ 0 0 30000 ];
GMAT WalkerView.ViewDirection = Earth;

%  ---- Ground Track ----
Create GroundTrackPlot WalkerGroundTrack;
GMAT WalkerGroundTrack.ShowPlot = true;
GMAT WalkerGroundTrack.Add = {A1, A2, A3, A4, A5, A6, A7, A8, B1, B2, B3, B4, B5, B6, B7, B8, C1, C2, C3, C4, C5, C6, C7, C8};
GMAT WalkerGroundTrack.CentralBody = Earth;

