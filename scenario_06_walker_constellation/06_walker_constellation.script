%  ---- Ground Stations ----
%  High latitude:  Tromso, Norway    (69.7 N, 18.9 E)
%  Mid latitude:   London, UK        (51.5 N,  0.1 W)
%  Low latitude:   Nairobi, Kenya    ( 1.3 S, 36.8 E)
%  Near-equator:   Lagos, Nigeria    ( 6.5 N,  3.4 E)

Create GroundStation Tromso;
GMAT Tromso.CentralBody = Earth;
GMAT Tromso.StateType = Spherical;
GMAT Tromso.HorizonReference = Ellipsoid;
GMAT Tromso.Location1 = 69.7;
GMAT Tromso.Location2 = 18.9;
GMAT Tromso.Location3 = 5.0;
GMAT Tromso.Id = 'Tromso';
GMAT Tromso.MinimumElevationAngle = 5;

Create GroundStation London;
GMAT London.CentralBody = Earth;
GMAT London.StateType = Spherical;
GMAT London.HorizonReference = Ellipsoid;
GMAT London.Location1 = 51.5;
GMAT London.Location2 = -0.1;
GMAT London.Location3 = 5.0;
GMAT London.Id = 'London';
GMAT London.MinimumElevationAngle = 5;

Create GroundStation Nairobi;
GMAT Nairobi.CentralBody = Earth;
GMAT Nairobi.StateType = Spherical;
GMAT Nairobi.HorizonReference = Ellipsoid;
GMAT Nairobi.Location1 = -1.3;
GMAT Nairobi.Location2 = 36.8;
GMAT Nairobi.Location3 = 5.0;
GMAT Nairobi.Id = 'Nairobi';
GMAT Nairobi.MinimumElevationAngle = 5;

Create GroundStation Lagos;
GMAT Lagos.CentralBody = Earth;
GMAT Lagos.StateType = Spherical;
GMAT Lagos.HorizonReference = Ellipsoid;
GMAT Lagos.Location1 = 6.5;
GMAT Lagos.Location2 = 3.4;
GMAT Lagos.Location3 = 5.0;
GMAT Lagos.Id = 'Lagos';
GMAT Lagos.MinimumElevationAngle = 5;

%  ---- Contact Finders ----
%  GMAT R2022a: ContactLocator.Target = single Spacecraft (scalar, not list).
%  ContactLocator.Observers = {list of ground stations} (list allowed).
%  Architecture: one ContactLocator per satellite, all 4 stations as Observers.
%  Output: 24 files (one per satellite), each listing contacts to all stations.
%  Plane A: A1-A8

Create ContactLocator CL_A1;
GMAT CL_A1.Target = A1;
GMAT CL_A1.Observers = {Tromso, London, Nairobi, Lagos};
GMAT CL_A1.Filename = 'C:\Users\Admin\Documents\Projects\GMAT_portfolio\scenario_06_walker_constellation\output\Contact_A1.txt';
GMAT CL_A1.OccultingBodies = {Earth};
GMAT CL_A1.RunMode = Automatic;
GMAT CL_A1.UseEntireInterval = true;
GMAT CL_A1.UseLightTimeDelay = true;

Create ContactLocator CL_A2;
GMAT CL_A2.Target = A2;
