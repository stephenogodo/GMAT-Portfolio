%  ============================================================
%  Scenario 07: Walker Constellation 24/3/1 - Ground Coverage
%  24 satellites, 3 orbital planes, phasing factor F=1
%  Inclination: 51.6 deg, SMA: 6778.14 km (ISS-equivalent LEO)
%  8 satellites per plane, evenly spaced at 45-deg true anomaly
%  Plane RAAN spacing: 120 deg apart (360/3 planes)
%  Phasing: F=1 -> offset = F*(360/T) = 1*(360/24) = 15 deg per plane
%  Measures: orbit view, ground track, access windows to
%  four representative ground stations (high/mid/low latitude)
%  ============================================================

%  ---- Force Model ----
Create ForceModel DefaultProp_FM;
GMAT DefaultProp_FM.CentralBody = Earth;
GMAT DefaultProp_FM.PrimaryBodies = {Earth};
GMAT DefaultProp_FM.GravityField.Earth.Degree = 4;
GMAT DefaultProp_FM.GravityField.Earth.Order = 4;
GMAT DefaultProp_FM.GravityField.Earth.Model = JGM2;
GMAT DefaultProp_FM.Drag.AtmosphereModel = None;
GMAT DefaultProp_FM.SRP = Off;

%  ---- Propagator ----
Create Propagator DefaultProp;
GMAT DefaultProp.FM = DefaultProp_FM;
GMAT DefaultProp.Type = RungeKutta89;
GMAT DefaultProp.InitialStepSize = 60;
GMAT DefaultProp.MinStep = 0.001;
GMAT DefaultProp.MaxStep = 2700;

%  ---- Plane A (RAAN = 0 deg): Satellites A1-A8 ----
%  Walker F=1: plane A offset = 0 * 15 = 0 deg TA shift

Create Spacecraft A1;
GMAT A1.DateFormat = UTCGregorian;
GMAT A1.Epoch = '01 Jan 2024 00:00:00.000';
GMAT A1.CoordinateSystem = EarthMJ2000Eq;
GMAT A1.DisplayStateType = Keplerian;
GMAT A1.SMA = 6778.14;
GMAT A1.ECC = 0.0001;
GMAT A1.INC = 51.6;
GMAT A1.RAAN = 0;
GMAT A1.AOP = 0;
GMAT A1.TA = 0;

Create Spacecraft A2;
GMAT A2.DateFormat = UTCGregorian;
GMAT A2.Epoch = '01 Jan 2024 00:00:00.000';
